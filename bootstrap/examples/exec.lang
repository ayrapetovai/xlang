// exec.lang — the tree-walking interpreter's witness (decision C24)
// run:  ./bootstrap run examples/exec.lang

module exec

User struct = {
  id int
  name string
}

Color enum = {
  RED
  GREEN
  BLUE
}

greet func (who string) string = {
  // format specifiers are out of bootstrap scope — literals stay opaque
  "greetings"
}

main func () int = {
  // arithmetic, swap, compound assignment
  a := 5
  b := 7
  a <> b
  out.println(a * 10 + b)  // 75
  total := a
  total += b
  total *= 2
  out.println(total)  // 26

  // if / then / else
  if total == 24 then
    out.println("if ok")
  else
    out.println("if broken")

  // in-clause ranges: ascending inclusive, descending, exclusive
  loop i in 1..=3 do
    out.println(i)  // 1 2 3
  loop i in 4 >..= 1 do
    out.println(i)  // 4 3 2 1
  n := 0
  loop i in 1..<10 do
    n += i
  out.println(n)  // 45

  // condition loop with break/continue
  i := 0
  loop i < 10 do {
    i += 1
    if i == 4 then
      continue
    if i > 7 then
      break
    out.println(i)  // 1 2 3 5 6 7
  }

  // c-for
  loop j := 0; j < 3; j += 1 do
    out.println(j)  // 0 1 2

  // arrays: build, index, index-assign, length
  xs [4]int = { 10, 20, 30, 40 }
  out.println(xs.length)  // 4
  out.println(xs[1])  // 20
  xs[1] = 21
  out.println(xs[1])  // 21
  loop i, v in xs do
    out.println(i)  // 0 1 2 3

  // structs, records, function values
  u User = { id = 7, name = "artem" }
  out.println(u.name)  // artem
  out.println(greet(u.name))  // hello, artem

  // enums and match
  c Color = RED
  match c {
    RED => out.println("red")
    GREEN => out.println("green")
    _ => out.println("other")
  }

  // casts: X.from(y) — fallible, never consumes the argument
  w := int.from("42") ?? 0
  out.println(w)  // 42
  f := float.from("6.5") ?? 0.0
  out.println(f)  // 6.5
  s := string.from(99)
  out.println(s)  // 99

  // try / catch over a raised cast failure
  try
    z := int.from("nope")!
    out.println(z)
  catch e
    out.println(e.message)

  // defers run when the function returns
  defer out.println("deferred")
  0
}